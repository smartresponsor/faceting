{
  "name": "faceting/facet",
  "description": "Faceting component for facet definitions, filtering, aggregation, and management workflows.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.4",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "doctrine/dbal": "^4.0",
    "doctrine/doctrine-bundle": "^3.2",
    "doctrine/doctrine-migrations-bundle": "^4.0",
    "doctrine/orm": "^3.3",
    "symfony/console": "7.3.* || ^8.0",
    "symfony/dotenv": "7.3.* || ^8.0",
    "symfony/error-handler": "7.3.* || ^8.0",
    "symfony/form": "7.3.* || ^8.0",
    "symfony/framework-bundle": "7.3.* || ^8.0",
    "symfony/runtime": "7.3.* || ^8.0",
    "symfony/security-bundle": "7.3.* || ^8.0",
    "symfony/twig-bundle": "7.3.* || ^8.0",
    "symfony/validator": "7.3.* || ^8.0",
    "symfony/yaml": "7.3.* || ^8.0",
    "interfacing/interface": "*@dev",
    "objecting/object": "*@dev"
  },
  "require-dev": {
    "doctrine/doctrine-fixtures-bundle": "^4.3",
    "fakerphp/faker": "^1.24",
    "friendsofphp/php-cs-fixer": "^3.95.4",
    "phpunit/phpunit": "^10.5",
    "symfony/browser-kit": "7.3.* || ^8.0",
    "symfony/css-selector": "7.3.* || ^8.0",
    "symfony/dom-crawler": "7.3.* || ^8.0",
    "symfony/phpunit-bridge": "7.3.* || ^8.0"
  },
  "autoload": {
    "psr-4": {
      "App\\Faceting\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Faceting\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "lint:php": [
      "php -l src/Kernel.php",
      "php -l bin/console",
      "php -l public/index.php"
    ],
    "lint:yaml": "php bin/console lint:yaml config --parse-tags",
    "lint:twig": "php bin/console lint:twig templates",
    "lint:container": "php bin/console lint:container",
    "cs:check": [
      "@lint:php"
    ],
    "test:unit": "phpunit --testsuite unit",
    "test:integration": "phpunit --testsuite integration",
    "test:functional": "phpunit --testsuite functional",
    "test": [
      "@test:unit",
      "@test:integration",
      "@test:functional"
    ],
    "pipeline:local:full": [
      "@lint:php",
      "@lint:yaml",
      "@lint:twig",
      "@lint:container",
      "@test"
    ]
  },
  "config": {
    "allow-plugins": {
      "symfony/runtime": true
    }
  },
  "repositories": [
    {
      "type": "path",
      "url": "../Objecting",
      "options": {
        "symlink": true
      }
    },
    {
      "type": "path",
      "url": "../Interfacing",
      "options": {
        "symlink": true
      }
    }
  ]
}

