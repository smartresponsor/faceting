{
  "name": "faceting/facet",
  "description": "Faceting component for facet definitions, filtering, aggregation, and management workflows.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.4",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "doctrine/dbal": "^4.0",
    "doctrine/doctrine-bundle": "^3.2",
    "doctrine/doctrine-migrations-bundle": "^4.0",
    "doctrine/orm": "^3.3",
    "symfony/console": "^8.1",
    "symfony/dotenv": "^8.1",
    "symfony/error-handler": "^8.1",
    "symfony/form": "^8.1",
    "symfony/framework-bundle": "^8.1",
    "symfony/runtime": "^8.1",
    "symfony/security-bundle": "^8.1",
    "symfony/serializer": "^8.1",
    "symfony/twig-bundle": "^8.1",
    "symfony/validator": "^8.1",
    "symfony/yaml": "^8.1",
    "cruding/crud": "*@dev",
    "easycorp/easyadmin-bundle": "^5.5",
    "interfacing/interface": "*@dev",
    "objecting/object": "*@dev",
    "viewing/view": "*@dev"
  },
  "require-dev": {
    "doctrine/doctrine-fixtures-bundle": "^4.3",
    "fakerphp/faker": "^1.24",
    "friendsofphp/php-cs-fixer": "^3.95.4",
    "gating/gate": "*@dev",
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^10.5",
    "symfony/browser-kit": "^8.1",
    "symfony/css-selector": "^8.1",
    "symfony/dom-crawler": "^8.1",
    "symfony/phpunit-bridge": "^8.1"
  },
  "autoload": {
    "psr-4": {
      "App\\Faceting\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Faceting\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "lint:php": [
      "php -l src/Kernel.php",
      "php -l bin/console",
      "php -l public/index.php"
    ],
    "lint:yaml": "php bin/console lint:yaml config --parse-tags",
    "lint:twig": "php bin/console lint:twig templates",
    "lint:container": "php bin/console lint:container",
    "cs:check": "php-cs-fixer fix --dry-run --diff --verbose",
    "cs:fix": "php-cs-fixer fix --verbose",
    "phpstan": "phpstan analyse src tests --level=8 --memory-limit=1G",
    "gating": "gating check --target=. --profile=.gating/config/profile.yaml",
    "validate:prod": "php -r \"json_decode(file_get_contents('composer.prod.json'), true, 512, JSON_THROW_ON_ERROR);\"",
    "doctrine:schema:validate": "php bin/console doctrine:schema:validate --skip-sync",
    "doctrine:migrations:currentness": "php bin/console doctrine:migrations:up-to-date --no-interaction",
    "test:unit": "phpunit --testsuite unit",
    "test:integration": "phpunit --testsuite integration",
    "test:functional": "phpunit --testsuite functional",
    "test": [
      "@test:unit",
      "@test:integration",
      "@test:functional"
    ],
    "pipeline:local:full": [
      "@lint:php",
      "@lint:yaml",
      "@lint:twig",
      "@lint:container",
      "@test"
    ]
  },
  "config": {
    "allow-plugins": {
      "symfony/runtime": true
    }
  },
  "repositories": [
    {
      "type": "path",
      "url": "../Gating",
      "options": {
        "symlink": true
      }
    },
    {
      "type": "path",
      "url": "../Cruding",
      "options": {
        "symlink": true
      }
    },
    {
      "type": "path",
      "url": "../Viewing",
      "options": {
        "symlink": true
      }
    },
    {
      "type": "path",
      "url": "../Objecting",
      "options": {
        "symlink": true
      }
    },
    {
      "type": "path",
      "url": "../Interfacing",
      "options": {
        "symlink": true
      }
    }
  ]
}

